NEXT_PUBLIC_APP_NAME=SLM
NEXT_PUBLIC_APP_MODE=mock

# Authentication: use anika_erp to validate the login form against Anika ERP.
# The ERP password is entered by the user at login and is never stored by this app.
AUTH_PROVIDER=demo
APP_DEFAULT_ROLE=OWNER
APP_ACTOR_ID=local-owner
APP_ACTOR_NAME=Owner
AUTH_TRUSTED_HEADER_SECRET=
AUTH_HEADER_USER_ID=x-aneka-user-id
AUTH_HEADER_USER_NAME=x-aneka-user-name
AUTH_HEADER_USER_ROLE=x-aneka-user-role
AUTH_ALLOW_DEMO_IN_PRODUCTION=false
AUTH_SSO_LOGIN_URL=
INITIAL_OWNER_EXTERNAL_ID=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_NAME=Owner

# Local JSON storage. Production should use PostgreSQL/Prisma; JSON remains for mock/dev migration.
DATA_DIR=./data
DATABASE_URL=postgresql://aneka_jaya:aneka_jaya@localhost:5432/aneka_jaya?schema=public
PRISMA_LOG_QUERIES=false

# ERP integration. Required when NEXT_PUBLIC_APP_MODE=production.
ANIKA_ERP_API_BASE_URL=https://ankjy.playgo.id/api/integrations
ANIKA_ERP_API_TOKEN=
ANIKA_ERP_AUTO_CREATE_CUSTOMER=true
ANIKA_ERP_AUTO_CUSTOMER_EMAIL_DOMAIN=slm.localhost.test
ANIKA_ERP_WALK_IN_CUSTOMER_ID=
ANIKA_ERP_WALK_IN_CUSTOMER_CODE=WALK-IN
ANIKA_ERP_DEFAULT_CABANG_ID=1
ANIKA_ERP_DEFAULT_PRODUCT_COST_PRICE=
SALES_ERP_TYPE_CODES=AJ,W,SLM,ONLINE
EXPENSE_ERP_TYPE_CODES=AJ

# OpenCloud upload. Required for production receipt uploads after the OpenCloud upload schema is finalized.
OPENCLOUD_API_BASE_URL=
OPENCLOUD_PROJECT_ID=
OPENCLOUD_API_KEY=
OPENCLOUD_STORAGE_BUCKET=
OPENCLOUD_MAX_FILE_SIZE_BYTES=5242880

# WhatsApp provider: meta_cloud_api or third_party.
WHATSAPP_PROVIDER=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_THIRD_PARTY_ENDPOINT=
WHATSAPP_THIRD_PARTY_TOKEN=

# Cron job protection for /api/jobs/*. Replace this placeholder before any production deployment.
CRON_SECRET=change-me

# Approval flags. Set to false to skip admin approval for that module.
REQUIRE_APPROVAL_PENJUALAN=false
REQUIRE_APPROVAL_PENGELUARAN=false
# MJ server-to-server integration
MJ_INTEGRATION_ENVIRONMENT=sandbox
MJ_RATE_LIMIT_MUTATION_PER_MINUTE=60
MJ_RATE_LIMIT_READ_PER_MINUTE=300

# CCTV SLM Integration (Webhook & Pull API)
CCTV_BASE_URL=http://31.97.51.194:8000
SLM_API_TOKEN=cctv_slm_8e119688c48b1880da69c9ab632b6c415ddc5f4d94467ea50305b951c5a0d04b
CCTV_API_TOKEN=cctv_slm_8e119688c48b1880da69c9ab632b6c415ddc5f4d94467ea50305b951c5a0d04b
CCTV_INTEGRATION_TOKEN=cctv_slm_8e119688c48b1880da69c9ab632b6c415ddc5f4d94467ea50305b951c5a0d04b

