generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SUPERVISOR
  ADMIN
  FINANCE
  MANAGER
  DELIVERY_DRIVER
  VIEWER
}

enum ApprovalStatus {
  draft
  pending_approval
  approved
  rejected
  cancelled
}

enum TempoStatus {
  open
  paid
  partial_paid
  overdue
  cancelled
  written_off
}

model User {
  id               String    @id
  externalId       String    @unique
  email            String?   @unique
  name             String
  role             Role
  isActive         Boolean   @default(true)
  passwordHash     String?
  passwordUpdatedAt DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([lockedUntil])
}

model AuditLog {
  id               String   @id
  entityType       String
  entityId         String
  action           String
  beforeValue      Json?
  afterValue       Json?
  userId           String
  userNameSnapshot String
  userRoleSnapshot Role
  ipAddress        String?
  userAgent        String?
  reason           String?
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ApprovalRequest {
  id                     String         @id
  module                 String
  entityId               String
  tipeCodeSnapshot       String?
  tipeNameSnapshot       String?
  amount                 Decimal?       @db.Decimal(18, 2)
  status                 ApprovalStatus
  createdByUserId        String
  createdByNameSnapshot  String
  createdByRoleSnapshot  Role
  createdAt              DateTime
  approvedByUserId       String?
  approvedByNameSnapshot String?
  approvedAt             DateTime?
  rejectedByUserId       String?
  rejectedByNameSnapshot String?
  rejectedAt             DateTime?
  rejectionReason        String?

  @@index([status])
  @@index([module, entityId])
}

model TempoReceivable {
  id                    String         @id
  salesId               String         @unique
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  customerName          String
  originalAmount        Decimal        @db.Decimal(18, 2)
  paidAmount            Decimal        @db.Decimal(18, 2)
  remainingAmount       Decimal        @db.Decimal(18, 2)
  transactionDate       DateTime
  dueDate               DateTime
  status                TempoStatus
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime
  updatedAt             DateTime
  payments              TempoPayment[]

  @@index([status])
  @@index([dueDate])
}

model TempoPayment {
  id                    String          @id
  tempoReceivableId     String
  tempoReceivable       TempoReceivable @relation(fields: [tempoReceivableId], references: [id], onDelete: Cascade)
  paymentDate           DateTime
  amountPaid            Decimal         @db.Decimal(18, 2)
  paymentMethod         String
  rekeningId            String
  rekeningNameSnapshot  String
  attachmentUrl         String?
  notes                 String?
  erpPaymentStatus      String          @default("not_required")
  erpPaymentError       String?
  erpPaymentReference   String?
  erpPaymentSyncedAt    DateTime?
  erpPaymentAttemptedAt DateTime?
  externalPaymentReference String? @unique
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime
  reversals             TempoPaymentReversal[]

  @@index([tempoReceivableId])
  @@index([paymentDate])
  @@index([erpPaymentStatus])
}

model TempoPaymentReversal {
  id                    String       @id
  tempoPaymentId        String
  tempoPayment          TempoPayment @relation(fields: [tempoPaymentId], references: [id], onDelete: Cascade)
  reversalDate          DateTime
  amount                Decimal      @db.Decimal(18, 2)
  reason                String
  erpStatus             String       @default("not_required")
  erpReference          String?
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime

  @@index([tempoPaymentId])
  @@index([reversalDate])
}

model SalesRecord {
  id                    String    @id
  saleDate              DateTime
  transactionNumber     String?
  transactionAt         DateTime?
  transactionSequence   Int?
  transactionDateKey    String?
  deliveryAt            DateTime?
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  customerName          String
  customerPhone         String?
  customerLocation      String?
  shippingMethod        String?
  paymentMethod         String
  dueDate               DateTime?
  initialPaymentAmount  Decimal   @default(0) @db.Decimal(18, 2)
  initialPaymentMethod  String?
  initialPaymentRekeningId String?
  initialPaymentRekeningNameSnapshot String?
  initialPaymentNotes   String?
  rekeningId            String?
  rekeningNameSnapshot  String?
  transferAccount       String?
  notes                 String?
  total                 Decimal   @db.Decimal(18, 2)
  approvalStatus        String
  syncTarget            String    @default("local")
  syncStatus            String    @default("local")
  syncError             String?
  syncAttemptedAt       DateTime?
  syncedAt              DateTime?
  erpReference          String?
  erpInvoiceId          Int?
  erpInvoiceNumber      String?
  erpSyncHttpStatus     Int?
  erpSyncResponse       Json?
  stockReleaseStatus    String    @default("not_required")
  stockReleaseError     String?
  stockReleaseReference String?
  stockReleasedAt       DateTime?
  stockReleaseHttpStatus Int?
  stockReleaseResponse  Json?
  erpPaymentStatus      String    @default("not_required")
  erpPaymentError       String?
  erpPaymentReference   String?
  erpPaymentSyncedAt    DateTime?
  erpPaymentAttemptedAt DateTime?
  testReference         String?
  isTestTransaction     Boolean   @default(false)
  source                String    @default("SLM")
  externalReference     String?
  integrationPayloadHash String?
  integrationClientId   String?
  integrationProcessingMode String?
  externalCustomerId    String?
  erpCustomerId         Int?
  customerSyncStatus    String    @default("not_required")
  customerSyncError     String?
  accountSnapshot       Json?
  integrationMetadata   Json?
  createdByUserId       String
  createdByNameSnapshot String
  createdByRoleSnapshot Role
  createdAt             DateTime
  doStatus              String    @default("belum_selesai")
  doPackingStatus       String    @default("belum")
  doShippingStatus      String    @default("belum")
  doAssignedUserId      String?
  doAssignedUserName    String?
  doReceiptPhotoUrl     String?
  doTrackingNumber      String?
  items                 SalesRecordItem[]
  integrationAttempts   IntegrationStageAttempt[]
  deliveryOrder         DeliveryOrder?
  cctvDetections        CctvDetectionLog[]

  @@index([saleDate])
  @@index([transactionNumber])
  @@unique([transactionDateKey, transactionSequence])
  @@index([approvalStatus])
  @@index([customerName])
  @@index([syncTarget, syncStatus])
  @@index([stockReleaseStatus])
  @@index([stockReleaseReference])
  @@index([erpInvoiceNumber])
  @@index([erpPaymentStatus])
  @@index([syncAttemptedAt])
  @@index([testReference])
  @@unique([source, externalReference])
  @@index([integrationClientId])
  @@index([integrationProcessingMode])
  @@index([customerSyncStatus])
}

model IntegrationClient {
  id          String   @id
  code        String   @unique
  name        String
  environment String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tokens      IntegrationToken[]

  @@index([environment, isActive])
}

model IntegrationToken {
  id          String   @id
  clientId    String
  client      IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  prefix      String
  environment String
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  rotatedFromId String?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([prefix])
  @@index([clientId, isActive])
}

model IntegrationRateLimit {
  id          String   @id
  clientId    String
  bucket      String
  windowStart DateTime
  requestCount Int     @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([clientId, bucket, windowStart])
  @@index([windowStart])
}

model IntegrationCustomerMapping {
  id                 String   @id
  source             String
  externalCustomerId String
  erpCustomerId      Int
  customerNameSnapshot String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([source, externalCustomerId])
  @@index([erpCustomerId])
}

model IntegrationStageAttempt {
  id            String   @id
  salesRecordId String
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  stage         String
  attemptNumber Int
  status        String
  errorCode     String?
  errorMessage  String?
  httpStatus    Int?
  response      Json?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@unique([salesRecordId, stage, attemptNumber])
  @@index([salesRecordId, stage, status])
}

model DailyTransactionCounter {
  dateKey     String   @id
  lastValue   Int
  updatedAt   DateTime @updatedAt
}

model BookkeepingType {
  id            String   @id
  code          String   @unique
  name          String
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rekeningLinks RekeningAccountBookkeepingType[]
}

model RekeningAccount {
  id            String   @id
  name          String
  accountNumber String?
  bankName      String?
  erpCoaId      String?
  erpCoaNameSnapshot String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tipeLinks     RekeningAccountBookkeepingType[]
}

model SalesRecordItem {
  id            String      @id
  salesRecordId String
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  productRef    String
  productId      String?
  manualProduct  Json?
  warehouseId    String?
  warehouseNameSnapshot String?
  rackId         String?
  rackNameSnapshot String?
  unitSnapshot   String?
  uomIdSnapshot  Int?
  quantity      Decimal     @db.Decimal(18, 2)
  unitPrice     Decimal     @db.Decimal(18, 2)
  discount      Decimal     @default(0) @db.Decimal(18, 2)
  sortOrder     Int
  deliveryOrderItem DeliveryOrderItem?

  @@index([salesRecordId])
  @@index([productRef])
  @@index([productId])
}

model ExpenseRecord {
  id                    String    @id
  expenseDate           DateTime
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  rekeningId            String
  rekeningNameSnapshot  String
  coaId                 String
  coaNameSnapshot       String
  category              String
  vendorName            String
  description           String
  amount                Decimal   @db.Decimal(18, 2)
  paymentMethod         String
  attachmentUrl         String?
  notes                 String?
  approvalStatus        String
  erpSyncTarget         String    @default("local")
  erpSyncStatus         String    @default("not_required")
  erpSyncError          String?
  erpSyncAttemptedAt    DateTime?
  erpSyncedAt           DateTime?
  erpReference          String?
  createdByUserId       String
  createdByNameSnapshot String
  createdByRoleSnapshot Role
  createdAt             DateTime

  @@index([expenseDate])
  @@index([approvalStatus])
  @@index([erpSyncTarget, erpSyncStatus])
  @@index([erpSyncAttemptedAt])
}

model RekeningAccountBookkeepingType {
  rekeningAccountId String
  bookkeepingTypeId String
  rekeningAccount   RekeningAccount @relation(fields: [rekeningAccountId], references: [id], onDelete: Cascade)
  bookkeepingType   BookkeepingType @relation(fields: [bookkeepingTypeId], references: [id], onDelete: Cascade)

  @@id([rekeningAccountId, bookkeepingTypeId])
  @@index([bookkeepingTypeId])
}

model AppSetting {
  key                  String   @id
  value                String
  description          String?
  updatedByUserId      String?
  updatedByNameSnapshot String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model WhatsAppRecipient {
  id                    String   @id
  name                  String
  phone                 String
  role                  String?
  isActive              Boolean  @default(true)
  receivesDailyReport   Boolean  @default(false)
  receivesStockAlert    Boolean  @default(false)
  receivesTempoReminder Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WhatsAppMessageLog {
  id                    String    @id
  recipientId           String?
  recipient             String
  messageType           String
  status                String
  payload               Json?
  response              Json?
  reportType            String?
  provider              String?
  recipientNameSnapshot String?
  phoneMaskedSnapshot   String?
  providerMessageId     String?
  errorMessage          String?
  sentAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model StockAlertLog {
  id              String   @id
  productRef      String
  productName     String
  currentQuantity Int
  minimumQuantity Int
  status          String
  sentTo          String?
  createdAt       DateTime @default(now())

  @@index([productRef])
  @@index([createdAt])
}

model DeliveryOrder {
  id                    String              @id @default(cuid())
  doNumber              String              @unique
  salesRecordId         String              @unique
  salesRecord           SalesRecord         @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  status                String              @default("belum_selesai")
  packingStatus         String              @default("belum")
  shippingStatus        String              @default("belum")
  assignedUserId        String?
  assignedUserName      String?
  assignedAt            DateTime?
  packedByUserId        String?
  packedByNameSnapshot  String?
  packedAt              DateTime?
  shippedByUserId       String?
  shippedByNameSnapshot String?
  shippedAt             DateTime?
  receiptPhotoUrl       String?
  trackingNumber        String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 DeliveryOrderItem[]
  assignees             DeliveryOrderAssignee[]

  @@index([salesRecordId])
  @@index([status])
  @@index([assignedUserId])
}

model DeliveryOrderItem {
  id                    String          @id @default(cuid())
  deliveryOrderId       String
  deliveryOrder         DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  salesRecordItemId     String          @unique
  salesRecordItem       SalesRecordItem @relation(fields: [salesRecordItemId], references: [id], onDelete: Cascade)
  productRef            String
  productNameSnapshot   String
  warehouseNameSnapshot String?
  rackNameSnapshot      String?
  unitSnapshot          String?
  quantity              Decimal         @db.Decimal(18, 2)
  isShipped             Boolean         @default(false)
  shippedQuantity       Decimal         @default(0) @db.Decimal(18, 2)
  shippedAt             DateTime?

  @@index([deliveryOrderId])
  @@index([salesRecordItemId])
}

model DeliveryOrderAssignee {
  id                     String        @id @default(cuid())
  deliveryOrderId        String
  deliveryOrder          DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  userId                 String
  userName               String
  assignedByUserId       String?
  assignedByNameSnapshot String?
  assignedAt             DateTime      @default(now())

  @@unique([deliveryOrderId, userId])
  @@index([deliveryOrderId])
  @@index([userId])
}

model CctvDetectionLog {
  id                 String       @id @default(cuid())
  cctvLabelId        Int?
  invoiceNumber      String?
  customerName       String?
  sourceLabel        String?
  slmReference       String?
  salesRecordId      String?
  salesRecord        SalesRecord? @relation(fields: [salesRecordId], references: [id], onDelete: SetNull)
  deliveryOrderId    String?
  cameraId           Int?
  cameraName         String?
  cameraLocation     String?
  eventType          String       @default("packing_completed")
  severity           String       @default("info")
  packingStatus      String       @default("completed")
  matchStatus        String       @default("matched")
  firstSeenAt        DateTime?
  packingCompletedAt DateTime?
  evidenceUrl        String?
  screenshotPhotoUrl String?
  rawPayload         Json?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([invoiceNumber])
  @@index([salesRecordId])
  @@index([cameraName])
  @@index([eventType])
  @@index([createdAt])
}

