generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SUPERVISOR
  ADMIN
  FINANCE
  MANAGER
  DELIVERY_DRIVER
  VIEWER
}

enum ApprovalStatus {
  draft
  pending_approval
  approved
  rejected
  cancelled
}

enum TempoStatus {
  open
  paid
  partial_paid
  overdue
  cancelled
  written_off
}

enum LoanType {
  KASBON
  UANG_MUKA
}

enum LoanStatus {
  ACTIVE
  PAID
  SETTLED
  CANCELLED
}

model User {
  id               String    @id
  externalId       String    @unique
  email            String?   @unique
  name             String
  role             Role
  isActive         Boolean   @default(true)
  passwordHash     String?
  passwordUpdatedAt DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([lockedUntil])
}

model AuditLog {
  id               String   @id
  entityType       String
  entityId         String
  action           String
  beforeValue      Json?
  afterValue       Json?
  userId           String
  userNameSnapshot String
  userRoleSnapshot Role
  ipAddress        String?
  userAgent        String?
  reason           String?
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ApprovalRequest {
  id                     String         @id
  module                 String
  entityId               String
  tipeCodeSnapshot       String?
  tipeNameSnapshot       String?
  amount                 Decimal?       @db.Decimal(18, 2)
  status                 ApprovalStatus
  createdByUserId        String
  createdByNameSnapshot  String
  createdByRoleSnapshot  Role
  createdAt              DateTime
  approvedByUserId       String?
  approvedByNameSnapshot String?
  approvedAt             DateTime?
  rejectedByUserId       String?
  rejectedByNameSnapshot String?
  rejectedAt             DateTime?
  rejectionReason        String?

  @@index([status])
  @@index([module, entityId])
}

model TempoReceivable {
  id                    String         @id
  salesId               String         @unique
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  customerName          String
  originalAmount        Decimal        @db.Decimal(18, 2)
  paidAmount            Decimal        @db.Decimal(18, 2)
  remainingAmount       Decimal        @db.Decimal(18, 2)
  transactionDate       DateTime
  dueDate               DateTime
  status                TempoStatus
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime
  updatedAt             DateTime
  payments              TempoPayment[]

  @@index([status])
  @@index([dueDate])
}

model TempoPayment {
  id                    String          @id
  tempoReceivableId     String
  tempoReceivable       TempoReceivable @relation(fields: [tempoReceivableId], references: [id], onDelete: Cascade)
  paymentDate           DateTime
  amountPaid            Decimal         @db.Decimal(18, 2)
  paymentMethod         String
  rekeningId            String
  rekeningNameSnapshot  String
  attachmentUrl         String?
  notes                 String?
  erpPaymentStatus      String          @default("not_required")
  erpPaymentError       String?
  erpPaymentReference   String?
  erpPaymentSyncedAt    DateTime?
  erpPaymentAttemptedAt DateTime?
  externalPaymentReference String? @unique
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime
  reversals             TempoPaymentReversal[]

  @@index([tempoReceivableId])
  @@index([paymentDate])
  @@index([erpPaymentStatus])
}

model TempoPaymentReversal {
  id                    String       @id
  tempoPaymentId        String
  tempoPayment          TempoPayment @relation(fields: [tempoPaymentId], references: [id], onDelete: Cascade)
  reversalDate          DateTime
  amount                Decimal      @db.Decimal(18, 2)
  reason                String
  erpStatus             String       @default("not_required")
  erpReference          String?
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime

  @@index([tempoPaymentId])
  @@index([reversalDate])
}

model SalesRecord {
  id                    String    @id
  saleDate              DateTime
  transactionNumber     String?
  transactionAt         DateTime?
  transactionSequence   Int?
  transactionDateKey    String?
  deliveryAt            DateTime?
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  customerName          String
  customerPhone         String?
  customerLocation      String?
  shippingMethod        String?
  paymentMethod         String
  dueDate               DateTime?
  initialPaymentAmount  Decimal   @default(0) @db.Decimal(18, 2)
  initialPaymentMethod  String?
  initialPaymentRekeningId String?
  initialPaymentRekeningNameSnapshot String?
  initialPaymentNotes   String?
  rekeningId            String?
  rekeningNameSnapshot  String?
  transferAccount       String?
  notes                 String?
  total                 Decimal   @db.Decimal(18, 2)
  approvalStatus        String
  syncTarget            String    @default("local")
  syncStatus            String    @default("local")
  syncError             String?
  syncAttemptedAt       DateTime?
  syncedAt              DateTime?
  erpReference          String?
  erpInvoiceId          Int?
  erpInvoiceNumber      String?
  erpSyncHttpStatus     Int?
  erpSyncResponse       Json?
  stockReleaseStatus    String    @default("not_required")
  stockReleaseError     String?
  stockReleaseReference String?
  stockReleasedAt       DateTime?
  stockReleaseHttpStatus Int?
  stockReleaseResponse  Json?
  erpPaymentStatus      String    @default("not_required")
  erpPaymentError       String?
  erpPaymentReference   String?
  erpPaymentSyncedAt    DateTime?
  erpPaymentAttemptedAt DateTime?
  testReference         String?
  isTestTransaction     Boolean   @default(false)
  source                String    @default("SLM")
  externalReference     String?
  integrationPayloadHash String?
  integrationClientId   String?
  integrationProcessingMode String?
  externalCustomerId    String?
  erpCustomerId         Int?
  customerSyncStatus    String    @default("not_required")
  customerSyncError     String?
  accountSnapshot       Json?
  integrationMetadata   Json?
  createdByUserId       String
  createdByNameSnapshot String
  createdByRoleSnapshot Role
  createdAt             DateTime
  doStatus              String    @default("belum_selesai")
  doPackingStatus       String    @default("belum")
  doShippingStatus      String    @default("belum")
  doAssignedUserId      String?
  doAssignedUserName    String?
  doReceiptPhotoUrl     String?
  doTrackingNumber      String?
  items                 SalesRecordItem[]
  integrationAttempts   IntegrationStageAttempt[]
  deliveryOrder         DeliveryOrder?
  cctvDetections        CctvDetectionLog[]
  journalEntryId        String?
  journalEntry          JournalEntry?             @relation("SalesInvoiceJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  cogsJournalEntryId    String?
  cogsJournalEntry      JournalEntry?             @relation("SalesCogsJournal", fields: [cogsJournalEntryId], references: [id], onDelete: SetNull)
  returns               SalesReturn[]

  @@index([saleDate])
  @@index([transactionNumber])
  @@unique([transactionDateKey, transactionSequence])
  @@index([approvalStatus])
  @@index([customerName])
  @@index([syncTarget, syncStatus])
  @@index([stockReleaseStatus])
  @@index([stockReleaseReference])
  @@index([erpInvoiceNumber])
  @@index([erpPaymentStatus])
  @@index([syncAttemptedAt])
  @@index([testReference])
  @@unique([source, externalReference])
  @@index([integrationClientId])
  @@index([integrationProcessingMode])
  @@index([customerSyncStatus])
  @@index([journalEntryId])
  @@index([cogsJournalEntryId])
}

model IntegrationClient {
  id          String   @id
  code        String   @unique
  name        String
  environment String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tokens      IntegrationToken[]

  @@index([environment, isActive])
}

model IntegrationToken {
  id          String   @id
  clientId    String
  client      IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  prefix      String
  environment String
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  rotatedFromId String?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([prefix])
  @@index([clientId, isActive])
}

model IntegrationRateLimit {
  id          String   @id
  clientId    String
  bucket      String
  windowStart DateTime
  requestCount Int     @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([clientId, bucket, windowStart])
  @@index([windowStart])
}

model IntegrationCustomerMapping {
  id                 String   @id
  source             String
  externalCustomerId String
  erpCustomerId      Int
  customerNameSnapshot String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([source, externalCustomerId])
  @@index([erpCustomerId])
}

model IntegrationStageAttempt {
  id            String   @id
  salesRecordId String
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  stage         String
  attemptNumber Int
  status        String
  errorCode     String?
  errorMessage  String?
  httpStatus    Int?
  response      Json?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@unique([salesRecordId, stage, attemptNumber])
  @@index([salesRecordId, stage, status])
}

model DailyTransactionCounter {
  dateKey     String   @id
  lastValue   Int
  updatedAt   DateTime @updatedAt
}

model BookkeepingType {
  id            String   @id
  code          String   @unique
  name          String
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rekeningLinks RekeningAccountBookkeepingType[]
}

model RekeningAccount {
  id            String   @id
  name          String
  accountNumber String?
  bankName      String?
  erpCoaId      String?
  erpCoaNameSnapshot String?
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  currency      String   @default("IDR")
  openingBalanceValas Decimal @default(0) @db.Decimal(18, 4)
  openingBalanceDate DateTime?
  openingRate   Decimal  @default(1) @db.Decimal(18, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tipeLinks     RekeningAccountBookkeepingType[]
  purchasePayments PurchasePayment[]
  landedCostPayments LandedCostItem[]
  salesReturns       SalesReturn[]
  savingsTransactions EmployeeSavingsTransaction[]

  @@index([accountId])
}

model SalesRecordItem {
  id            String      @id
  salesRecordId String
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  productRef    String
  productId      String?
  manualProduct  Json?
  warehouseId    String?
  warehouseNameSnapshot String?
  rackId         String?
  rackNameSnapshot String?
  unitSnapshot   String?
  uomIdSnapshot  Int?
  quantity      Decimal     @db.Decimal(18, 2)
  unitPrice     Decimal     @db.Decimal(18, 2)
  discount      Decimal     @default(0) @db.Decimal(18, 2)
  sortOrder     Int
  deliveryOrderItem DeliveryOrderItem?

  @@index([salesRecordId])
  @@index([productRef])
  @@index([productId])
}

model ExpenseRecord {
  id                    String    @id
  expenseDate           DateTime
  tipeId                String
  tipeCodeSnapshot      String
  tipeNameSnapshot      String
  rekeningId            String
  rekeningNameSnapshot  String
  coaId                 String
  coaNameSnapshot       String
  category              String
  vendorName            String
  description           String
  amount                Decimal   @db.Decimal(18, 2)
  paymentMethod         String
  attachmentUrl         String?
  notes                 String?
  approvalStatus        String
  erpSyncTarget         String    @default("local")
  erpSyncStatus         String    @default("not_required")
  erpSyncError          String?
  erpSyncAttemptedAt    DateTime?
  erpSyncedAt           DateTime?
  erpReference          String?
  createdByUserId       String
  createdByNameSnapshot String
  createdByRoleSnapshot Role
  createdAt             DateTime

  categoryCode          String    @default("operational_expense")
  employeeId            String?
  employee              Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  salaryPeriod          String?
  dueDate               DateTime?
  purpose               String?
  postingStatus         String    @default("unposted")
  journalEntryId        String?
  employeeLoans         EmployeeLoan[]
  salaryPayments        EmployeeSalaryPayment[]

  @@index([expenseDate])
  @@index([approvalStatus])
  @@index([erpSyncTarget, erpSyncStatus])
  @@index([erpSyncAttemptedAt])
  @@index([categoryCode])
  @@index([employeeId])
  @@index([salaryPeriod])
}

model Employee {
  id                    String                  @id @default(cuid())
  nik                   String?                 @unique
  name                  String
  position              String
  department            String
  managerId             String?
  manager               Employee?               @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          Employee[]              @relation("EmployeeHierarchy")
  isActive              Boolean                 @default(true)
  bankName              String?
  bankAccountNumber     String?
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  expenseRecords        ExpenseRecord[]
  loans                 EmployeeLoan[]
  loanPayments          EmployeeLoanPayment[]
  salaryPayments        EmployeeSalaryPayment[]
  savingsAccount        EmployeeSavings?

  @@index([isActive])
  @@index([department])
  @@index([managerId])
}

model EmployeeLoan {
  id                    String                        @id @default(cuid())
  employeeId            String
  employee              Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenseRecordId       String
  expenseRecord         ExpenseRecord                 @relation(fields: [expenseRecordId], references: [id], onDelete: Cascade)
  loanType              LoanType
  amount                Decimal                       @db.Decimal(18, 2)
  paidAmount            Decimal                       @default(0) @db.Decimal(18, 2)
  remainingAmount       Decimal                       @db.Decimal(18, 2)
  disbursedDate         DateTime
  dueDate               DateTime?
  purpose               String
  status                LoanStatus                    @default(ACTIVE)
  notes                 String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  payments              EmployeeLoanPayment[]
  settlement            OperationalAdvanceSettlement?

  @@index([employeeId])
  @@index([expenseRecordId])
  @@index([loanType, status])
  @@index([dueDate])
}

model EmployeeLoanPayment {
  id                    String              @id @default(cuid())
  loanId                String
  loan                  EmployeeLoan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paymentDate           DateTime
  amount                Decimal             @db.Decimal(18, 2)
  paymentMethod         String
  rekeningId            String?
  rekeningNameSnapshot  String?
  payrollReference      String?
  notes                 String?
  attachmentUrl         String?
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime            @default(now())

  @@index([loanId])
  @@index([employeeId])
  @@index([paymentDate])
}

model OperationalAdvanceSettlement {
  id                     String        @id @default(cuid())
  loanId                 String        @unique
  loan                   EmployeeLoan  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  settlementDate         DateTime
  actualExpenseAmount    Decimal       @db.Decimal(18, 2)
  refundAmount           Decimal       @default(0) @db.Decimal(18, 2)
  refundRekeningId       String?
  refundRekeningSnapshot String?
  notes                  String?
  attachmentUrl          String?
  createdByUserId        String
  createdByNameSnapshot  String
  createdAt              DateTime      @default(now())

  @@index([settlementDate])
}

model EmployeeSalaryPayment {
  id                    String        @id @default(cuid())
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenseRecordId       String
  expenseRecord         ExpenseRecord @relation(fields: [expenseRecordId], references: [id], onDelete: Cascade)
  periodMonth           String
  paymentDate           DateTime
  amountPaid            Decimal       @db.Decimal(18, 2)
  rekeningId            String
  rekeningNameSnapshot  String
  paymentMethod         String
  attachmentUrl         String?
  notes                 String?
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime      @default(now())

  @@index([employeeId])
  @@index([expenseRecordId])
  @@index([periodMonth])
  @@index([paymentDate])
}

model RekeningAccountBookkeepingType {
  rekeningAccountId String
  bookkeepingTypeId String
  rekeningAccount   RekeningAccount @relation(fields: [rekeningAccountId], references: [id], onDelete: Cascade)
  bookkeepingType   BookkeepingType @relation(fields: [bookkeepingTypeId], references: [id], onDelete: Cascade)

  @@id([rekeningAccountId, bookkeepingTypeId])
  @@index([bookkeepingTypeId])
}

model AppSetting {
  key                  String   @id
  value                String
  description          String?
  updatedByUserId      String?
  updatedByNameSnapshot String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model WhatsAppRecipient {
  id                    String   @id
  name                  String
  phone                 String
  role                  String?
  isActive              Boolean  @default(true)
  receivesDailyReport   Boolean  @default(false)
  receivesStockAlert    Boolean  @default(false)
  receivesTempoReminder Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WhatsAppMessageLog {
  id                    String    @id
  recipientId           String?
  recipient             String
  messageType           String
  status                String
  payload               Json?
  response              Json?
  reportType            String?
  provider              String?
  recipientNameSnapshot String?
  phoneMaskedSnapshot   String?
  providerMessageId     String?
  errorMessage          String?
  sentAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model StockAlertLog {
  id              String   @id
  productRef      String
  productName     String
  currentQuantity Int
  minimumQuantity Int
  status          String
  sentTo          String?
  createdAt       DateTime @default(now())

  @@index([productRef])
  @@index([createdAt])
}

model DeliveryOrder {
  id                    String              @id @default(cuid())
  doNumber              String              @unique
  salesRecordId         String              @unique
  salesRecord           SalesRecord         @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  status                String              @default("belum_selesai")
  packingStatus         String              @default("belum")
  shippingStatus        String              @default("belum")
  assignedUserId        String?
  assignedUserName      String?
  assignedAt            DateTime?
  packedByUserId        String?
  packedByNameSnapshot  String?
  packedAt              DateTime?
  shippedByUserId       String?
  shippedByNameSnapshot String?
  shippedAt             DateTime?
  receiptPhotoUrl       String?
  trackingNumber        String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 DeliveryOrderItem[]
  assignees             DeliveryOrderAssignee[]

  @@index([salesRecordId])
  @@index([status])
  @@index([assignedUserId])
}

model DeliveryOrderItem {
  id                    String          @id @default(cuid())
  deliveryOrderId       String
  deliveryOrder         DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  salesRecordItemId     String          @unique
  salesRecordItem       SalesRecordItem @relation(fields: [salesRecordItemId], references: [id], onDelete: Cascade)
  productRef            String
  productNameSnapshot   String
  warehouseNameSnapshot String?
  rackNameSnapshot      String?
  unitSnapshot          String?
  quantity              Decimal         @db.Decimal(18, 2)
  isShipped             Boolean         @default(false)
  shippedQuantity       Decimal         @default(0) @db.Decimal(18, 2)
  shippedAt             DateTime?

  @@index([deliveryOrderId])
  @@index([salesRecordItemId])
}

model DeliveryOrderAssignee {
  id                     String        @id @default(cuid())
  deliveryOrderId        String
  deliveryOrder          DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  userId                 String
  userName               String
  assignedByUserId       String?
  assignedByNameSnapshot String?
  assignedAt             DateTime      @default(now())

  @@unique([deliveryOrderId, userId])
  @@index([deliveryOrderId])
  @@index([userId])
}

model CctvDetectionLog {
  id                 String       @id @default(cuid())
  cctvLabelId        Int?
  invoiceNumber      String?
  customerName       String?
  sourceLabel        String?
  slmReference       String?
  salesRecordId      String?
  salesRecord        SalesRecord? @relation(fields: [salesRecordId], references: [id], onDelete: SetNull)
  deliveryOrderId    String?
  cameraId           Int?
  cameraName         String?
  cameraLocation     String?
  eventType          String       @default("packing_completed")
  severity           String       @default("info")
  packingStatus      String       @default("completed")
  matchStatus        String       @default("matched")
  firstSeenAt        DateTime?
  packingCompletedAt DateTime?
  evidenceUrl        String?
  screenshotPhotoUrl String?
  rawPayload         Json?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([invoiceNumber])
  @@index([salesRecordId])
  @@index([cameraName])
  @@index([eventType])
  @@index([createdAt])
  @@index([packingCompletedAt])
  @@index([firstSeenAt])
}

// =====================================================================
// FASE 2: AKUNTANSI, JURNAL, BUKU BESAR & COA
// =====================================================================

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model Account {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  category      AccountCategory
  normalBalance NormalBalance
  description   String?
  isActive      Boolean         @default(true)
  isSystem      Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  journalLines  JournalLine[]
  rekenings     RekeningAccount[]

  @@index([category])
  @@index([isActive])
  @@index([code])
}

model JournalEntry {
  id                    String        @id @default(cuid())
  journalNumber         String        @unique
  entryDate             DateTime
  sourceType            String        // EXPENSE | SALES | LOAN_REPAYMENT | ADVANCE_SETTLEMENT | MANUAL
  sourceId              String?
  postingType           String        // DISBURSEMENT | REPAYMENT | SETTLEMENT | ACCRUAL | MANUAL | REVERSAL
  tipeId                String?
  tipeCodeSnapshot      String?
  description           String
  status                JournalStatus @default(POSTED)
  totalDebit            Decimal       @db.Decimal(18, 2)
  totalCredit           Decimal       @db.Decimal(18, 2)
  isReversal            Boolean       @default(false)
  reversalOfJournalId   String?       @unique
  reversedByJournalId   String?       @unique
  reversalReason        String?
  attachmentUrl         String?
  createdByUserId       String
  createdByNameSnapshot String
  postedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  lines                 JournalLine[]
  purchaseInvoice       PurchaseInvoice?
  landedCostItem        LandedCostItem?
  purchasePayment       PurchasePayment?
  salesInvoiceRecords   SalesRecord[] @relation("SalesInvoiceJournal")
  salesCogsRecords      SalesRecord[] @relation("SalesCogsJournal")
  salesReturns          SalesReturn[]
  savingsTransactions   EmployeeSavingsTransaction[]

  @@unique([sourceType, sourceId, postingType])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([tipeId])
}

model JournalLine {
  id                  String        @id @default(cuid())
  journalEntryId      String
  journalEntry        JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account       @relation(fields: [accountId], references: [id])
  accountCodeSnapshot String
  accountNameSnapshot String
  debit               Decimal       @default(0) @db.Decimal(18, 2)
  credit              Decimal       @default(0) @db.Decimal(18, 2)
  memo                String?
  sortOrder           Int           @default(0)

  @@index([journalEntryId])
  @@index([accountId])
}

model AccountingPeriod {
  periodKey             String    @id // format "YYYY-MM"
  isClosed              Boolean   @default(false)
  closedAt              DateTime?
  closedByUserId        String?
  closedByNameSnapshot  String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// =====================================================================
// FASE 3: PEMBELIAN VALAS, MULTI-CURRENCY & LANDED COST
// =====================================================================

enum RateType {
  BOOKING
  BANK_ACTUAL
  TAX_KMK
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL_RECEIVED
  COMPLETED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIAL_PAID
  PAID
  CANCELLED
}

enum LandedCostType {
  FREIGHT
  CUSTOMS_DUTY
  IMPORT_TAX_PPN
  IMPORT_TAX_PPH22
  INSURANCE
  HANDLING
  OTHER
}

enum LandedCostAllocationMethod {
  BY_VALUE
  BY_QUANTITY
}

model CurrencyRate {
  id            String    @id @default(cuid())
  currency      String    // "USD", "RMB", etc.
  rateDate      DateTime
  rateType      RateType  // BOOKING, BANK_ACTUAL, TAX_KMK
  rate          Decimal   @db.Decimal(18, 4)
  source        String?   // "BI", "BCA", "KMK"
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([currency, rateDate, rateType])
  @@index([currency, rateDate])
}

model Supplier {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  country          String            @default("ID")
  currency         String            @default("IDR")
  contactPerson    String?
  phone            String?
  email            String?
  address          String?
  taxId            String?
  paymentTermsDays Int               @default(30)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  purchasePayments PurchasePayment[]

  @@index([code])
  @@index([name])
}

model PurchaseOrder {
  id                     String              @id @default(cuid())
  poNumber               String              @unique
  supplierId             String
  supplier               Supplier            @relation(fields: [supplierId], references: [id])
  orderDate              DateTime
  expectedDeliveryDate   DateTime?
  currency               String              @default("USD")
  exchangeRate           Decimal             @default(1) @db.Decimal(18, 4)
  subtotalOriginal       Decimal             @default(0) @db.Decimal(18, 4)
  subtotalIdr            Decimal             @default(0) @db.Decimal(18, 2)
  totalTaxIdr            Decimal             @default(0) @db.Decimal(18, 2)
  totalAmountOriginal    Decimal             @default(0) @db.Decimal(18, 4)
  totalAmountIdr         Decimal             @default(0) @db.Decimal(18, 2)
  status                 PurchaseOrderStatus @default(DRAFT)
  notes                  String?
  createdByUserId        String
  createdByNameSnapshot  String
  approvedByUserId       String?
  approvedByNameSnapshot String?
  approvedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  items                  PurchaseOrderItem[]
  receipts               PurchaseReceipt[]
  invoices               PurchaseInvoice[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id                  String                @id @default(cuid())
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemCode            String
  itemName            String
  unit                String                @default("PCS")
  quantity            Decimal               @db.Decimal(18, 2)
  receivedQuantity    Decimal               @default(0) @db.Decimal(18, 2)
  unitPriceOriginal   Decimal               @db.Decimal(18, 4)
  unitPriceIdr        Decimal               @db.Decimal(18, 2)
  totalAmountOriginal Decimal               @db.Decimal(18, 4)
  totalAmountIdr      Decimal               @db.Decimal(18, 2)
  notes               String?
  sortOrder           Int                   @default(0)

  receiptItems        PurchaseReceiptItem[]

  @@index([purchaseOrderId])
}

model PurchaseReceipt {
  id                     String                @id @default(cuid())
  grnNumber              String                @unique
  purchaseOrderId        String
  purchaseOrder          PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receiptDate            DateTime
  warehouseName          String                @default("Gudang Utama")
  notes                  String?
  receivedByUserId       String
  receivedByNameSnapshot String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  items                  PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receiptDate])
}

model PurchaseReceiptItem {
  id                  String            @id @default(cuid())
  purchaseReceiptId   String
  purchaseReceipt     PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  itemCode            String
  itemName            String
  unit                String
  quantityReceived    Decimal           @db.Decimal(18, 2)
  notes               String?

  @@index([purchaseReceiptId])
  @@index([purchaseOrderItemId])
}

model PurchaseInvoice {
  id                    String                @id @default(cuid())
  invoiceNumber         String                @unique
  supplierInvoiceNumber String
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplierId            String
  supplier              Supplier              @relation(fields: [supplierId], references: [id])
  invoiceDate           DateTime
  dueDate               DateTime
  currency              String                @default("USD")
  exchangeRate          Decimal               @db.Decimal(18, 4)
  subtotalOriginal      Decimal               @db.Decimal(18, 4)
  subtotalIdr           Decimal               @db.Decimal(18, 2)
  landedCostTotalIdr    Decimal               @default(0) @db.Decimal(18, 2)
  totalAmountOriginal   Decimal               @db.Decimal(18, 4)
  totalAmountIdr        Decimal               @db.Decimal(18, 2)
  totalPaidOriginal     Decimal               @default(0) @db.Decimal(18, 4)
  totalPaidIdr          Decimal               @default(0) @db.Decimal(18, 2)
  status                PurchaseInvoiceStatus @default(DRAFT)
  notes                 String?
  journalEntryId        String?               @unique
  journalEntry          JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  landedCosts           LandedCostItem[]
  payments              PurchasePayment[]

  @@index([supplierId])
  @@index([status])
  @@index([invoiceDate])
}

model LandedCostItem {
  id                 String                     @id @default(cuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice            @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  costType           LandedCostType
  isCreditableTax    Boolean                    @default(false)
  description        String
  vendorName         String?
  originalCurrency   String                     @default("IDR")
  originalAmount     Decimal                    @db.Decimal(18, 4)
  exchangeRate       Decimal                    @default(1) @db.Decimal(18, 4)
  amountIdr          Decimal                    @db.Decimal(18, 2)
  allocationMethod   LandedCostAllocationMethod @default(BY_VALUE)
  paymentAccountId   String?
  paymentAccount     RekeningAccount?           @relation(fields: [paymentAccountId], references: [id])
  notes              String?
  journalEntryId     String?                    @unique
  journalEntry       JournalEntry?              @relation(fields: [journalEntryId], references: [id])
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([purchaseInvoiceId])
  @@index([costType])
}

model PurchasePayment {
  id                    String          @id @default(cuid())
  paymentNumber         String          @unique
  purchaseInvoiceId     String
  purchaseInvoice       PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  supplierId            String
  supplier              Supplier        @relation(fields: [supplierId], references: [id])
  paymentDate           DateTime
  rekeningAccountId     String
  rekeningAccount       RekeningAccount @relation(fields: [rekeningAccountId], references: [id])
  currency              String
  amountPaidOriginal    Decimal         @db.Decimal(18, 4)
  paymentRate           Decimal         @db.Decimal(18, 4)
  invoiceRate           Decimal         @db.Decimal(18, 4)
  settledPayableIdr     Decimal         @db.Decimal(18, 2)
  totalPaidIdr          Decimal         @db.Decimal(18, 2)
  forexDiffIdr          Decimal         @db.Decimal(18, 2)
  forexAccountCode      String
  notes                 String?
  journalEntryId        String?         @unique
  journalEntry          JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@index([rekeningAccountId])
  @@index([paymentDate])
}

enum SalesReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesReturnRefundMethod {
  REDUCE_RECEIVABLE
  REFUND_CASH
}

model SalesReturn {
  id                    String                   @id @default(cuid())
  returnNumber          String                   @unique
  salesRecordId         String
  salesRecord           SalesRecord              @relation(fields: [salesRecordId], references: [id], onDelete: Restrict)
  returnDate            DateTime
  customerName          String
  refundMethod          SalesReturnRefundMethod  @default(REDUCE_RECEIVABLE)
  rekeningAccountId     String?
  rekeningAccount       RekeningAccount?         @relation(fields: [rekeningAccountId], references: [id], onDelete: SetNull)
  subtotalAmount        Decimal                  @db.Decimal(18, 2)
  totalCostPrice        Decimal                  @default(0) @db.Decimal(18, 2)
  status                SalesReturnStatus        @default(DRAFT)
  notes                 String?
  journalEntryId        String?
  journalEntry          JournalEntry?            @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  items                 SalesReturnItem[]

  @@index([salesRecordId])
  @@index([returnDate])
  @@index([status])
  @@index([rekeningAccountId])
  @@index([journalEntryId])
}

model SalesReturnItem {
  id                    String       @id @default(cuid())
  salesReturnId         String
  salesReturn           SalesReturn  @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesRecordItemId     String?
  productRef            String
  productName           String
  unit                  String       @default("PCS")
  quantity              Decimal      @db.Decimal(18, 2)
  unitPrice             Decimal      @db.Decimal(18, 2)
  unitCostPrice         Decimal      @default(0) @db.Decimal(18, 2)
  totalAmount           Decimal      @db.Decimal(18, 2)
  totalCost             Decimal      @default(0) @db.Decimal(18, 2)
  reason                String?

  @@index([salesReturnId])
  @@index([productRef])
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum SavingsTransactionSource {
  DIRECT_CASH
  SALARY_DEDUCTION
  MANUAL_ADJUSTMENT
}

model EmployeeSavings {
  id                    String                       @id @default(cuid())
  employeeId            String                       @unique
  employee              Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountNumber         String                       @unique
  balance               Decimal                      @default(0) @db.Decimal(18, 2)
  isActive              Boolean                      @default(true)
  notes                 String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  transactions          EmployeeSavingsTransaction[]

  @@index([employeeId])
}

model EmployeeSavingsTransaction {
  id                    String                   @id @default(cuid())
  savingsAccountId      String
  savingsAccount        EmployeeSavings          @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  transactionDate       DateTime
  type                  SavingsTransactionType
  source                SavingsTransactionSource @default(DIRECT_CASH)
  amount                Decimal                  @db.Decimal(18, 2)
  balanceAfter          Decimal                  @db.Decimal(18, 2)
  rekeningAccountId     String?
  rekeningAccount       RekeningAccount?         @relation(fields: [rekeningAccountId], references: [id], onDelete: SetNull)
  journalEntryId        String?
  journalEntry          JournalEntry?            @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  notes                 String?
  createdByUserId       String
  createdByNameSnapshot String
  createdAt             DateTime                 @default(now())

  @@index([savingsAccountId])
  @@index([transactionDate])
}
